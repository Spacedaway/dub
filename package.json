{
  "name": "dub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "spell": "cspell lint --no-progress --gitignore .",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:rust && pnpm format:check && pnpm format:rust:check && pnpm spell && pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ctrl/video-filename-parser": "5.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-http": "~2.8.3",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "anitomy-ng": "1.0.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "cspell": "10.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.1.0"
  }
}
