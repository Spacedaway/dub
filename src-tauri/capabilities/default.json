{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "sql:allow-select",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.tvmaze.com/*"
        }
      ]
    }
  ]
}
